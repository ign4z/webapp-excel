{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/protect-files.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/lint-edited.mjs",
            "timeout": 60,
            "statusMessage": "ESLint sul file modificato..."
          },
          {
            "type": "command",
            "command": "node scripts/hooks/test-related.mjs",
            "timeout": 120,
            "statusMessage": "Test Vitest collegati al file modificato..."
          }
        ]
      }
    ]
  }
}
