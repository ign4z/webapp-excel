# Admin Security
ADMIN_TOKEN=il-tuo-token-segreto-12345
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Vercel Blob Storage — lo store deve essere creato con accesso PRIVATO
# (config, prezzi strade e report Excel vengono tutti letti/scritti in modalità private)
BLOB_READ_WRITE_TOKEN=

# Segreto HMAC per il token di sessione Step 1 -> Step 2 (fallback: ADMIN_TOKEN)
SESSION_SECRET=

# Resend API Key (registrati su resend.com)
RESEND_API_KEY=
# Mittente (dominio verificato su Resend) e destinatario notifiche admin
EMAIL_FROM="Valutazione Immobiliare <noreply@tuodominio.it>"
ADMIN_EMAIL=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Maps Places Autocomplete
NEXT_PUBLIC_GOOGLE_API_KEY=
# Chiave Google lato server (Geocoding API) per "Verifica con Google" e import vie ufficiali nell'admin.
# Senza restrizione per referrer (Google rifiuta dal server le chiavi limitate al sito): limitala alla Geocoding API.
GOOGLE_MAPS_SERVER_KEY=

# reCAPTCHA (obbligatorio in produzione: senza secret i form vengono rifiutati)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Logging
# Livelli disponibili: error | warn | info | debug | trace
# Default: "info" in produzione, "debug" in sviluppo
LOG_LEVEL=info

# Rate limit form pubblici (opzionale). Con Upstash Redis il limite vale su tutte le istanze;
# senza, si usa un limite in memoria per singola istanza.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
