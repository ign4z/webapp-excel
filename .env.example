# Admin Security
ADMIN_TOKEN=il-tuo-token-segreto-12345
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Vercel Blob Storage — lo store deve essere creato con accesso PRIVATO
# (config, prezzi strade e report Excel vengono tutti letti/scritti in modalità private)
# In produzione: token dello store di produzione. In locale NON va messo: lo store di sviluppo usa OIDC
# (BLOB_STORE_ID + VERCEL_OIDC_TOKEN in .env.development.local, da `vercel env pull`; vedi README, "Store Blob di sviluppo")
BLOB_READ_WRITE_TOKEN=
# Solo in .env.local (mai su Vercel): id dello store di produzione. Se il token sopra appartiene a questo
# store, fuori dalla produzione ogni scrittura/cancellazione su Blob viene rifiutata.
BLOB_PRODUCTION_STORE_ID=

# Segreto HMAC per il token di sessione Step 1 -> Step 2 (fallback: ADMIN_TOKEN)
SESSION_SECRET=

# Resend API Key (registrati su resend.com)
RESEND_API_KEY=
# Mittente (dominio verificato su Resend)
EMAIL_FROM="Valutazione Immobiliare <noreply@tuodominio.it>"
# Destinatari di riserva della notifica di nuova valutazione (virgola tra più indirizzi):
# usati solo se in /admin/settings non ne è configurato nessuno
ADMIN_EMAIL=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Maps Places Autocomplete
NEXT_PUBLIC_GOOGLE_API_KEY=
# Chiave Google lato server (Geocoding API) per "Verifica con Google" e import vie ufficiali nell'admin.
# Senza restrizione per referrer (Google rifiuta dal server le chiavi limitate al sito): limitala alla Geocoding API.
GOOGLE_MAPS_SERVER_KEY=

# Cloudflare Turnstile, verifica anti-bot dei form (obbligatorio in produzione: senza secret i form vengono rifiutati)
# Chiavi di test per lo sviluppo (passano sempre): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Segreto del Cron Vercel che cancella i report più vecchi della conservazione dichiarata (vercel.json, lib/legal.ts).
# Vercel lo invia come "Authorization: Bearer <CRON_SECRET>"; senza, il cron risponde 401.
CRON_SECRET=

# Logging
# Livelli disponibili: error | warn | info | debug | trace
# Default: "info" in produzione, "debug" in sviluppo
LOG_LEVEL=info

# Rate limit form pubblici (opzionale). Con Upstash Redis il limite vale su tutte le istanze;
# senza, si usa un limite in memoria per singola istanza.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
