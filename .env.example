# Admin Security
ADMIN_TOKEN=il-tuo-token-segreto-12345
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Vercel Blob Storage (auto-generato dopo deploy)
BLOB_READ_WRITE_TOKEN=

# Resend API Key (registrati su resend.com)
RESEND_API_KEY=

# reCAPTCHA v3 (console.cloud.google.com)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Logging
# Livelli disponibili: error | warn | info | debug | trace
# Default: "info" in produzione, "debug" in sviluppo
LOG_LEVEL=info
# Salva i log su Vercel Blob (logs/YYYY-MM-DD.jsonl) — richiede BLOB_READ_WRITE_TOKEN
# Leggibili via GET /api/admin/logs?token=SECRET&date=YYYY-MM-DD
LOG_BLOB_ENABLED=false
